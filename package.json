{
  "name": "@requestflo/trpc-live",
  "version": "0.2.0",
  "description": "A drop-in replacement for tRPC's httpSubscriptionLink that also applies server-driven query invalidations to your TanStack Query cache.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsd",
    "test:all": "pnpm typecheck && pnpm test && pnpm build && pnpm test:types",
    "prepublishOnly": "pnpm test:all"
  },
  "tsd": {
    "directory": "test/type",
    "compilerOptions": {
      "strict": true,
      "module": "esnext",
      "target": "es2022",
      "lib": [
        "DOM",
        "DOM.Iterable",
        "ES2022"
      ],
      "esModuleInterop": true,
      "skipLibCheck": true
    }
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "react": "^19.0.0",
    "tsd": "^0.31.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
